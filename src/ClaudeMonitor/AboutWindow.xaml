<Window x:Class="ClaudeMonitor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Claude Monitor"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="320" SizeToContent="Height"
        Topmost="True"
        MouseLeftButtonDown="Window_Drag">

    <Border Padding="10">
    <Border CornerRadius="12" Padding="24">
        <Border.Background>
            <SolidColorBrush Color="#1a1a2e" Opacity="0.95"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Color="#000000" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel>
            <!-- Close -->
            <TextBlock Text="✕" FontSize="13" Foreground="#555" Cursor="Hand"
                       HorizontalAlignment="Right" Margin="0,0,0,4"
                       MouseLeftButtonDown="Close_Click"/>

            <!-- Icon + Name -->
            <TextBlock Text="Claude Monitor" FontSize="20" FontWeight="Bold" Foreground="#c084fc"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="tbVersion" FontSize="12" Foreground="#888"
                       HorizontalAlignment="Center" Margin="0,4,0,16"/>

            <!-- Info -->
            <Border CornerRadius="8" Padding="14" Background="#252545" Margin="0,0,0,10">
                <TextBlock Text="Desktop widget for real-time monitoring of Claude Code sessions."
                           FontSize="11" Foreground="#aaa" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>

            <!-- Details -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Author" FontSize="10" Foreground="#666" Margin="0,0,12,6"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Aliaksandr Rubis" FontSize="10" Foreground="#ccc" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="License" FontSize="10" Foreground="#666" Margin="0,0,12,6"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="MIT" FontSize="10" Foreground="#ccc" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="GitHub" FontSize="10" Foreground="#666" Margin="0,0,12,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="10" Foreground="#7c8aff" Cursor="Hand"
                           MouseLeftButtonDown="GitHub_Click"
                           Text="sanyastem/ClaudeMonitor"
                           TextDecorations="Underline"/>
            </Grid>

            <!-- Copyright -->
            <TextBlock Text="Copyright (c) 2026 Aliaksandr Rubis" FontSize="9" Foreground="#555"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
    </Border>
</Window>
